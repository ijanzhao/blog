name: Supabase Keep Alive

# 极简版:对两个 Supabase 项目各发一个 GET 请求,触发 PostgREST,
# 算作项目活动。比旧版减少了依赖、减少了出错环节。
#
# 需要在仓库 Settings > Secrets and variables > Actions 里添加:
#   IJAN_APP_URL          = https://gotdehypsbkbyrasdbrr.supabase.co
#   IJAN_APP_ANON_KEY      = (ijan.app 项目的 anon key)
#   IJANZHAO_APP_URL       = https://jgcibolwmwotsymhgtjr.supabase.co
#   IJANZHAO_APP_ANON_KEY  = (ijanzhao-app 项目的 anon key)

on:
  schedule:
    - cron: '0 3 */3 * *'   # 每 3 天一次,UTC 03:00
  workflow_dispatch: {}

jobs:
  keep-alive:
    runs-on: ubuntu-latest
    steps:
      - name: Ping ijan.app
        run: |
          curl -sS -f "${{ secrets.IJAN_APP_URL }}/rest/v1/" \
            -H "apikey: ${{ secrets.IJAN_APP_ANON_KEY }}" \
            || echo "ijan.app ping 失败,但不阻断后续步骤"

      - name: Ping ijanzhao-app
        run: |
          curl -sS -f "${{ secrets.IJANZHAO_APP_URL }}/rest/v1/" \
            -H "apikey: ${{ secrets.IJANZHAO_APP_ANON_KEY }}" \
            || echo "ijanzhao-app ping 失败,但不阻断后续步骤"
