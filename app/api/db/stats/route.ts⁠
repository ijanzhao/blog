import { NextResponse } from 'next/server';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  process.env.SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY!
);

export async function GET() {
  try {
    // 采用最轻量的 head: true 模式，不消耗网络带宽、由数据库高效计数返回
    const [speciesCount, compoundCount, researchCount, productCount] = await Promise.all([
      supabase.from('species').select('*', { count: 'exact', head: true }),
      supabase.from('compounds').select('*', { count: 'exact', head: true }),
      supabase.from('natural_product_research').select('*', { count: 'exact', head: true }),
      supabase.from('products').select('*', { count: 'exact', head: true }),
    ]);

    return NextResponse.json({
      total_species: speciesCount.count || 0,
      total_compounds: compoundCount.count || 0,
      total_research_records: researchCount.count || 0,
      total_products: productCount.count || 0,
      updated_at: new Date().toISOString()
    });
  } catch (error: any) {
    return NextResponse.json({ error: error.message }, { status: 500 });
  }
}
